ADJ_SHA = "0ad4f16f8ce9909402dc2f0c3df78b6ac17a65dca56613e96fffc2f62034a8be"
PROP_REL = "sp_durable/1Cor/close/landed/D3_e1/method_change_proposals.1Cor.candidate.jsonl"
