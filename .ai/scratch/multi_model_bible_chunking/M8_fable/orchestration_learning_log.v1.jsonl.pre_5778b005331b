{"schema": "m8_orchestration_learning.v1", "date": "2026-09-11", "supersedes": null, "id": "L-0009", "book": "Ezek", "stage": "fixup3_launch", "element": "budget", "observation": "FIXUP-3's launch tests assumed 293,072 tokens per author, FIXUP-2's measured maximum; p08 used 383,192. The ceiling was never at risk, but the assumption understated the cost.", "evidence_refs": ["sp_durable/Ezek/fixup2/ezek_author_fixup_attempt_receipts.jsonl", "sp_durable/Ezek/fixup3/ezek_author_fixup_attempt_receipts.jsonl"], "metric": {"assumed": 293072, "measured_max": 383192}, "verdict": "mixed", "recommendation": "Launch tests use the running measured maximum for the lane and model, or the largest single execution measured in the book when the lane has no history on that model."}
