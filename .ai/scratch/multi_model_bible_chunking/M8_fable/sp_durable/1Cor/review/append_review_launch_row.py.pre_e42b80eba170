#!/usr/bin/env python3
"""Append the launch receipt of one 1 Corinthians review lane to
SP/1Cor/review/1cor_review_attempt_receipts.jsonl.

Derived 2026-10-20 by exact replacements from ../writer_lanes/append_launch_row.py (itself ported 2026-10-19 from
../phase0_lanes/append_launch_row.py); the refusal rules are unchanged. The row takes the shape of
the Phase 0 launch rows (m8_attempt_receipt.v1), plus the launch-message file and its sha256 (ledger E-62). The part's
runtime id goes in agent_id, never in parent_agent_id, which holds "orchestrator" (ledger E-63). The orders field names
OW-36, the owner's grant for this book. It refuses unless all of the following hold:
  - --launched-at is a measured ISO time no earlier than the message file and no later than now;
  - the brief is at --brief-sha;
  - the message file is at --message-sha, and `_launch_message_check.py --book 1Cor` still returns MATCH on it;
  - the pin guard is CLEAR on the receipts file;
  - the receipts file is at --expect-before (ABSENT for the first row);
  - the execution has no launch row yet;
  - for --execution N > 1, execution N-1 has a launch row AND a landing row (one the pin guard's lands() accepts).
It appends under an exclusive lock with an atomic replace and a post-write check.

usage: append_review_launch_row.py --lane S1 --agent-id ID --brief-sha SHA --message-sha SHA --expect-before SHA|ABSENT
                            --launched-at ISO [--execution N --retry-reason TEXT]
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

sys.stdout.reconfigure(encoding="utf-8")
HERE = Path(__file__).resolve().parent
SP = HERE.parents[1]
sys.dont_write_bytecode = True
sys.path.insert(0, str(SP / "campaign"))
from _inflight_pin_guard import lands  # noqa: E402  one landing rule, shared with the pin guard
REC = SP / "1Cor" / "review" / "1cor_review_attempt_receipts.jsonl"
SCR = (r"C:\Users\lowel\AppData\Local\Temp\claude\C--Users-lowel-OneDrive-Desktop-Git-Projects-03-World-View"
       r"\af84b702-d913-4495-8e57-252cf7894c63\scratchpad")
PARTS = {"S1": ("cor_writer_wave_spot_review_s1_a1", "review_S1",
                "1 Corinthians S1 distinct-checker spot review of the installed combined writer draft "
                "(1Cor/writer/draft_rows_combined.jsonl): form, seams, a stratified row sample, Greek bytes, book-wide "
                "checks, flags and confidence against the binding strategy; not a lens. Writes in OUT only"),
         "CTL_E1": ("cor_controlling_rulings_r1_a1", "controlling_r1",
                    "1 Corinthians controlling execution, round 1 (Fable's role on claude-opus-5-5, OW-25/OW-30): "
                    "rules on every item of 1Cor/review/1cor_controlling_agent_queue_e1.v1.json (S1's findings, the "
                    "tool fixes, the fix-up scope and the gate); items for Fable's end review listed. Writes in OUT "
                    "only"),
         "S2": ("cor_fixup_wave_review_s2_a1", "review_S2",
                "1 Corinthians S2 fresh distinct-checker review of the FIXUP-1 applied rows "
                "(1Cor/fixup/draft_rows_fixup1_applied.jsonl): tests every E1 s2_condition from the bytes and its own "
                "runs (tool-fix receipts with plants, fix-up spans against the inlined licence maps, suite, tiling, "
                "ngram7, the CWO reports), the ruled findings, the carried items, an untouched sample and the digests; "
                "records readiness fit or fit_with_changes; not a lens. Writes in OUT only"),
         "CTL_E2": ("cor_controlling_rulings_r2_a1", "controlling_r2",
                    "1 Corinthians controlling execution, round 2 (Fable's role on claude-opus-5-5, OW-25/OW-30): "
                    "rules on every item of 1Cor/review/1cor_controlling_agent_queue_e2.v1.json (S2's findings, the "
                    "class rulings, the next tool fix, the fix-up scope and the gate for S3); items for Fable's end "
                    "review listed. Writes in OUT only"),
         "CTL_E3": ("cor_controlling_rulings_r3_a1", "controlling_r3",
                    "1 Corinthians controlling execution, round 3 (Fable's role on claude-opus-5-5, OW-25/OW-30): "
                    "rules on every item of 1Cor/review/1cor_controlling_agent_queue_e3.v1.json (S3's findings and "
                    "the gate for the primaries or a further fix-up); items for Fable's end review listed. Writes in "
                    "OUT only"),
         "CTL_E4": ("cor_controlling_rulings_r4_a1", "controlling_r4",
                    "1 Corinthians controlling execution, round 4 (Fable's role on claude-opus-5-5, OW-25/OW-30): "
                    "rules on every item of 1Cor/review/1cor_controlling_agent_queue_e4.v1.json (the 23 primaries' "
                    "challenges, the triage, the uncertainties and the gate for FIXUP-3 and S4); items for Fable's end review listed. Writes in "
                    "OUT only"),
         "S5": ("cor_fixup3_review_s5_a1", "review_S5",
                "1 Corinthians S5 fresh distinct-checker review of the FIXUP-3 applied rows "
                "(1Cor/fixup/draft_rows_fixup3_applied.jsonl), in ACCEPT form against GATE-E4 s2_conditions; not a lens. "
                "Writes in OUT only")}
OUTDIR = {"S1": "cor_s1", "CTL_E1": "cor_ctl1", "S2": "cor_s2", "CTL_E2": "cor_ctl2", "CTL_E3": "cor_ctl3", "CTL_E4": "cor_ctl4",
          "S5": "cor_s5_out"}
BRIEFNAME = {"S1": "BRIEF_S1", "CTL_E1": "CONTROLLING_BRIEF_E1", "S2": "BRIEF_S2",
             "CTL_E2": "CONTROLLING_BRIEF_E2", "CTL_E3": "CONTROLLING_BRIEF_E3", "CTL_E4": "CONTROLLING_BRIEF_E4",
             "S5": "BRIEF_S5"}
# Every part needs an explicit producer and catcher (the Phase 0 tables once defaulted a wrong pair; E-75).
PRODUCER = {p: "this lane (1 Corinthians review lane %s, claude-opus-5-5 on grader_fallback, OW-25)" % p for p in PARTS}
CATCHER = {p: ("the orchestrator's landing check of the deliverable against its schema and its claimed runs; the "
               "controlling execution that rules on its findings; Fable at the campaign-end review (OW-28)") for p in PARTS}
CATCHER["CTL_E1"] = ("the orchestrator's landing check of the deliverable (one ruling per queue id, the gate fields); "
                     "the fix-up authors and S2, who apply and test its orders; Fable at the campaign-end review (OW-28)")
CATCHER["S2"] = ("the orchestrator's landing check of the deliverable against its schema and its claimed runs; the "
                 "controlling execution that rules on any change it requires; the two blind lanes and the "
                 "reception-tradition lens that read the rows after it; Fable at the campaign-end review (OW-28)")
CATCHER["CTL_E2"] = ("the orchestrator's landing check of the deliverable (one ruling per queue id, the gate fields); "
                     "the FIXUP-2 authors and S3, who apply and test its orders; Fable at the campaign-end review "
                     "(OW-28)")
CATCHER["CTL_E3"] = ("the orchestrator's landing check of the deliverable (one ruling per queue id, the gate fields); "
                     "the two blind primary lanes and the reception-tradition lens, or the next fix-up and S4, who "
                     "act on its gate; Fable at the campaign-end review (OW-28)")
CATCHER["CTL_E4"] = ("the orchestrator's landing check of the deliverable (one ruling per queue id, the gate fields); "
                     "the two blind primary lanes and the reception-tradition lens, or the next fix-up and S4, who "
                     "act on its gate; Fable at the campaign-end review (OW-28)")
CATCHER["S5"] = ("the orchestrator's landing check of the deliverable against its schema and its claimed runs; a further "
                 "controlling execution if readiness is fit_with_changes; the merged-close lanes that read the rows after "
                 "it; Fable at the campaign-end review (OW-28)")
if set(PRODUCER) != set(PARTS) or set(CATCHER) != set(PARTS):
    raise SystemExit("REFUSED: every part needs an explicit PRODUCER and CATCHER entry")
sha = lambda b: hashlib.sha256(b).hexdigest()      # noqa: E731
ap = argparse.ArgumentParser()
for _n in ("W1", "W2", "W3", "W4", "W5", "W6"):
    _p = "FX3_" + _n
    PARTS[_p] = ("cor_fixup3_%s_a1" % _n, "fixup3:" + _n,
                 "1 Corinthians FIXUP-3 author for part %s: carries out the round-4 rulings' orders to that part, CWO-1COR-06 and "
                 "-07 and, for W4, S3-01 (claude-opus-5-5 on grader_fallback, OW-25). Writes in OUT only" % _n)
    OUTDIR[_p] = "cor_fx3\\" + _n
    BRIEFNAME[_p] = "FIXUP3_BRIEF_" + _n
    PRODUCER[_p] = "this lane (1 Corinthians FIXUP-3 author, part %s, claude-opus-5-5 on grader_fallback, OW-25)" % _n
    CATCHER[_p] = ("the orchestrator's landing check (fixup/fx3/land_fixup3.py: changed fields against the licence, suite, ngram7, "
                   "tiling and sweep on the applied copy), then S5, a fresh agent on the applied rows")
ap.add_argument("--lane", dest="part", required=True, choices=sorted(PARTS))
ap.add_argument("--agent-id", required=True)
ap.add_argument("--brief-sha", required=True)
ap.add_argument("--message-sha", required=True)
ap.add_argument("--expect-before", required=True)
ap.add_argument("--launched-at", required=True)
ap.add_argument("--execution", type=int, default=1)
ap.add_argument("--retry-reason")
a = ap.parse_args()
att, lane, role = PARTS[a.part]
if a.execution < 1 or (a.execution > 1) != bool(a.retry_reason):
    raise SystemExit("REFUSED: --execution must be >= 1, and --retry-reason is required exactly when it is > 1")
eid = "%s#e%d" % (att, a.execution)
prev = "%s#e%d" % (att, a.execution - 1) if a.execution > 1 else None
tag = "" if a.execution == 1 else "_e%d" % a.execution
brief = HERE / ("%s%s.md" % (BRIEFNAME[a.part], tag))
msg = Path(SCR) / "cor_review_msgs" / ("launch_message_%s%s.txt" % (a.part, tag))
_now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
_floor = datetime.fromtimestamp(msg.stat().st_mtime, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", a.launched_at) or not _floor <= a.launched_at <= _now:
    raise SystemExit("REFUSED: --launched-at %s is not a measured time in [%s, %s]" % (a.launched_at, _floor, _now))
if sha(brief.read_bytes()) != a.brief_sha:
    raise SystemExit("REFUSED: the brief is not at --brief-sha")
if sha(msg.read_bytes()) != a.message_sha:
    raise SystemExit("REFUSED: the launch message is not at --message-sha")
env = dict(os.environ, PYTHONUTF8="1", PYTHONDONTWRITEBYTECODE="1")
run = lambda *x: subprocess.run([sys.executable, "-B", *x], cwd=str(SP), capture_output=True, text=True,  # noqa: E731
                                encoding="utf-8", env=env)
lm = json.loads(run("campaign/_launch_message_check.py", "--book", "1Cor", "--message", str(msg)).stdout)
if lm["verdict"] != "MATCH":
    raise SystemExit("REFUSED: the launch message no longer MATCHes: %s" % lm["gaps"])
g = json.loads(run("campaign/_inflight_pin_guard.py", "--book", "1Cor", "--target", "1Cor/review/" + REC.name).stdout)
if g["verdict"] != "CLEAR":
    raise SystemExit("REFUSED by pin guard: %s" % json.dumps(g)[-300:])
before = REC.read_bytes() if REC.exists() else None
if (a.expect_before == "ABSENT") != (before is None) or (before is not None and sha(before) != a.expect_before):
    raise SystemExit("REFUSED: receipts are at %s, not --expect-before"
                     % (sha(before)[:12] if before is not None else "ABSENT"))
before = before or b""
rows = [json.loads(x) for x in before.decode("utf-8").splitlines() if x.strip()]
launched = {r.get("execution_id") for r in rows if r.get("record_kind") == "launch"}
landed = {x for r in rows if lands(r) for x in (r.get("execution_id"), r.get("amends_execution_id")) if x}
if eid in launched:
    raise SystemExit("REFUSED: %s already has a launch row" % eid)
if prev and not (prev in launched and prev in landed):
    raise SystemExit("REFUSED: %s needs a launch row and a landing row before %s may launch" % (prev, eid))
now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
row = {"schema": "m8_attempt_receipt.v1", "record_kind": "launch", "attempt_id": att, "execution_id": eid,
       "execution_of": att, "execution_ordinal": a.execution, "previous_execution_id": prev, "retry_of": prev,
       "retry_reason": a.retry_reason, "book": "1Cor",
       "lane": lane, "role": role,
       "producer": PRODUCER[a.part], "catcher": CATCHER[a.part],
       "agent": "general-purpose subagent", "agent_id": a.agent_id, "parent_agent_id": "orchestrator",
       "model": "claude-opus-5-5", "model_actual": "PENDING - read from the completion usage block", "effort": "inherited",
       "orders": "launch message file (E-62): verify the brief sha, read it whole, execute; OW-36 grant; E-13 (NT "
                 "preamble); E-19; M8-EFFICIENCY-V1",
       "launch_message": str(msg), "launch_message_sha256": a.message_sha,
       "brief": "sp_durable/1Cor/review/" + brief.name, "brief_sha256": a.brief_sha,
       "launched_at": a.launched_at, "recorded_at": now, "outcome": "RUNNING",
       "output_dir": SCR + "\\" + OUTDIR[a.part] + tag,
       "tokens_unit_note": "at landing record BOTH units: notification (the ceiling unit, OW-28) and spend (usage "
                           "fields, E-55)"}
after = (before + (b"" if not before or before.endswith(b"\n") else b"\n")
         + (json.dumps(row, ensure_ascii=False) + "\n").encode("utf-8"))
lock = REC.with_suffix(REC.suffix + ".lock")
fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
try:
    if (REC.read_bytes() if REC.exists() else b"") != before:
        raise SystemExit("REFUSED: receipts changed under the lock")
    tmp = REC.with_suffix(REC.suffix + ".tmp")
    tmp.write_bytes(after)
    os.replace(tmp, REC)
    if sha(REC.read_bytes()) != sha(after):
        REC.write_bytes(before)
        raise SystemExit("ROLLED BACK: receipt post-write check failed")
finally:
    os.close(fd)
    lock.unlink()
print(json.dumps({"appended": eid, "receipts": [sha(before), sha(after)]}))
