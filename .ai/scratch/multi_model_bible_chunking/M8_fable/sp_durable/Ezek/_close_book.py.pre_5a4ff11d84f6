def gate(name, ok, detail=""):
    GATES.append({"gate": name, "met": bool(ok), "detail": str(detail)[:400]})
    return bool(ok)


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def shab(b):
    return hashlib.sha256(b).hexdigest()


def jl(p):
    return [json.loads(l) for l in Path(p).read_text(encoding="utf-8-sig").splitlines() if l.strip()]


def jload(p):
    return json.loads(Path(p).read_text(encoding="utf-8-sig"))


def hi_med(xs):
    return [r for r in (xs or []) if isinstance(r, dict) and r.get("severity") in ("high", "medium")]


def run(args):
    p = subprocess.run([sys.executable, "-B"] + args, cwd=str(EZ), capture_output=True, text=True, encoding="utf-8",
                       errors="replace", env={**__import__("os").environ, "PYTHONUTF8": "1"})
    return p.returncode, (p.stdout or "").strip().splitlines()[-1:] or [""]


def corpus_gates():
    cp = EZ / CORPUS
    gate("corpus pinned", sha(cp) == CORPUS_PIN, sha(cp)[:16])
    rows = jl(cp)
    n = len(rows)
    gate("every row candidate_review_complete", all(r["review_status"] == "candidate_review_complete" for r in rows))
    gate("chunk_index 1..N", [r["chunk_index_in_book"] for r in rows] == list(range(1, n + 1)), n)
    # tiling: contiguous over the WEB order, no gap and no overlap
    order = [(c, v) for c in sorted(ezek_lib.LAST_VERSE) for v in range(1, ezek_lib.LAST_VERSE[c] + 1)]
    lin = {cv: i for i, cv in enumerate(order)}
    prev, bad, covered = -1, [], 0
    for r in rows:
        m = re.match(r"^Ezek\.(\d+)\.(\d+)-Ezek\.(\d+)\.(\d+)$", r["span"])
        s, e = lin.get((int(m.group(1)), int(m.group(2)))), lin.get((int(m.group(3)), int(m.group(4))))
        if s is None or e is None or s != prev + 1 or e < s:
            bad.append(r["decision_id"])
        else:
            covered += e - s + 1
            prev = e
    gate("tiling contiguous over 1273 WEB verses", not bad and covered == ezek_lib.TOTAL_VERSES == len(order) == 1273
         and prev == len(order) - 1, {"covered": covered, "breaks": bad[:5]})
    runs = [k for k, _ in __import__("itertools").groupby(r["parent_collection"] for r in rows)]
    gate("each parent collection one contiguous run", len(runs) == len(set(runs)),
         [p for p, c in collections.Counter(runs).items() if c > 1][:3])
    return rows


def lineage_gates():
    """v9 is v8 plus exactly the manifest's (row, field) changes: every other line is byte-identical (OW-28)."""
    gate("base corpus (v8) pinned", sha(EZ / BASE) == BASE_PIN, sha(EZ / BASE)[:16])
    gate("v8 -> v9 manifest pinned", sha(DELTA_MANIFEST) == DELTA_MANIFEST_PIN, sha(DELTA_MANIFEST)[:16])
    man = jload(DELTA_MANIFEST)
    gate("manifest built from the base, names this corpus", (man.get("built_from") or {}).get("sha256") == BASE_PIN
         and man.get("corpus_sha256") == CORPUS_PIN and man.get("corpus") == CORPUS)
    old = (EZ / BASE).read_bytes().decode("utf-8").splitlines()
    new = (EZ / CORPUS).read_bytes().decode("utf-8").splitlines()
    want, vals = collections.defaultdict(set), {}
    for c in man.get("changes") or []:
        want[c["row"]].add(c["field"])
        vals[(c["row"], c["field"])] = (c.get("before_sha256"), c.get("after_sha256"))
    same, bad = 0, []
    for i, (x, y) in enumerate(zip(old, new), 1):
        rx, ry = json.loads(x), json.loads(y)
        rid = rx.get("decision_id")
        if x == y:
            same += 1
            if rid in want:
                bad.append("%s unchanged but listed" % rid)
            continue
        diff = {k for k in set(rx) | set(ry) if rx.get(k) != ry.get(k)}
        if rid != ry.get("decision_id") or diff != want.get(rid):
            bad.append("%s line %d: %s" % (rid, i, sorted(diff)[:4]))
        for k in diff:
            h = (shab(json.dumps(rx.get(k), ensure_ascii=False).encode("utf-8")),
                 shab(json.dumps(ry.get(k), ensure_ascii=False).encode("utf-8")))
            if vals.get((rid, k)) != h:
                bad.append("%s.%s before/after sha" % (rid, k))
    gate("v9 differs from v8 only where the manifest says", len(old) == len(new) and not bad
         and same == len(old) - len(want) == man.get("unchanged_rows_byte_identical")
         and sorted(want) == sorted(man.get("rows_changed") or []), {"same": same, "bad": bad[:4]})
    return man


