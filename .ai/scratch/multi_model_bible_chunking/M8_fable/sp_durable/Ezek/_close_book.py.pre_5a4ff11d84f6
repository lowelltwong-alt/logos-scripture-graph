    assert "books_completed: 26" in back and "  Ezek:\n    status: complete\ncurrent_book: %s" % NEXT_BOOK in back
    assert sha(out / "chunks.jsonl") == shab(payload) and sha(M8 / "receipts" / "Ezek_completion.json") == shab(rec_bytes)
    print(json.dumps({"status": "CLOSED", "chunks": len(final), "receipt_sha256": shab(rec_bytes),
