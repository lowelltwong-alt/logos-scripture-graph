        raise SystemExit("REFUSED: %d gate(s) unmet; nothing written" % len(unmet))

    # --- CLOSE: the owner's act (OW-11 / OW-25). Every target was proven absent or anchored above. ---
    out = M8 / "book_chunks" / "Ezek"
    out.mkdir(parents=True, exist_ok=True)
