        gate("delta lane %s: over v9, base v8, manifest pinned" % L, dc.get("corpus_sha256") == CORPUS_PIN
             and dc.get("base_corpus_sha256") == BASE_PIN and dc.get("manifest_sha256") == DELTA_MANIFEST_PIN,
