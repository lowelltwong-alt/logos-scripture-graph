    if not gate("delta landing manifest present", land is not None, landing.name):
        return out, None
    recs = jl(DELTA_RECEIPTS)
    for L, att in DELTA_LANES:
        ent = (land.get("lanes") or {}).get(L) or {}
        files, ok = {}, True
