    doc, dsj = docket_gates(lanes, delta)
    disp = disposition_gates(lanes, delta, Path(a.dispositions).resolve() if a.dispositions else DISPOSITIONS)
    pk = fable_gates(rows, dlanding)
    prog, man = target_gates()
    if a.close:
        gate("--acf chosen for --close (owner's choice; see docstring)", a.acf is not None, a.acf)

    # --- payloads ---
    final = []
    for i, r in enumerate(rows, 1):
        fr = dict(r)
        fr["decision_id"] = "M8-Ezek-%03d" % i
        final.append(fr)
    payload = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in final).encode("utf-8")
    by = {s["writer_decision_id"]: s for s in side}
    lcr, feq, acf_lam = [], [], []
    for r in final:
        s = by.get(r["writer_decision_id"])
        if not s:
            continue
        common = {"model_id": "M8_fable", "book": "Ezek", "span": r["span"], "chunk_decision_id": r["decision_id"],
                  "confidence": r["confidence"], "review_packet_final_state": "accepted_candidate",
                  "chunk_review_status": "candidate_review_complete", "candidate_hold_state": None,
                  "non_authorizing": True, "observed_substrate_signals": r["observed_substrate_signals"]}
        lcr.append({**common, "why_low_confidence": s["why_low_confidence"]})
        feq.append({**common, "concern_type": s["concern_type"], "why_frontier_review_needed": s["why_frontier_review_needed"]})
        acf_lam.append({**common, "concern_type": s["concern_type"], "why_low_confidence": s["why_low_confidence"]})
    acf_item22 = jl(EZ / "deliverables" / "atlas_candidate_feed_rows.jsonl")
    gate("item-22 rows name only chunks of this book", all(x.get("book") == "Ezek" and x["chunk_decision_id"] in
                                                            {r["decision_id"] for r in final} for x in acf_item22))
    acf = {"lam_pattern": acf_lam, "item22": acf_item22}.get(a.acf)
    by_id = {r["decision_id"]: r for r in final}
    low_ids = {k for k, r in by_id.items() if r["confidence"] in ("low", "medium_low")}

    def coverage(opt):
        """The coverage validator's per-book feed rule (its lines 177-194), measured over an option's rows."""
        ids = [x.get("chunk_decision_id") for x in opt]
        stale = [x["chunk_decision_id"] for x in opt if x.get("chunk_decision_id") in low_ids and (any(
            x.get(f) != by_id[x["chunk_decision_id"]].get(g) for f, g in (
                ("span", "span"), ("confidence", "confidence"), ("chunk_review_status", "review_status"),
                ("candidate_hold_state", "candidate_hold_state"))) or x.get("review_packet_final_state") != (
            "accepted_candidate" if by_id[x["chunk_decision_id"]].get("candidate_hold_state") is None
            else "held_lower_confidence"))]
        return {"duplicates": len(ids) - len(set(ids)), "missing": sorted(low_ids - set(ids)),
                "orphan": sorted(set(ids) - low_ids), "stale": sorted(stale)}
    cov = {"lam_pattern": coverage(acf_lam), "item22": coverage(acf_item22)}
    cov_ok = lambda c: not (c["duplicates"] or c["missing"] or c["orphan"] or c["stale"])      # noqa: E731
    if a.acf:
        gate("atlas feed option %s meets the coverage validator's per-book rule" % a.acf, cov_ok(cov[a.acf]),
             {k: (v if isinstance(v, int) else v[:4]) for k, v in cov[a.acf].items()})
    shapes = collections.defaultdict(set)
