DATT = {"A": "ezek_fixround_v9_delta_lane_a_a1", "B": "ezek_fixround_v9_delta_lane_b_a1"}
DERIVED = ("atlas_rows", "atlas_dimensions", "atlas_check", "sidecars", "proposals", "readme")
