+    if not RANGE_NUM.search(between) or EXPECT_MODAL.search(between):
+        return "coordinated", first.start()
+    return "positive", first.start()
+
+
+def denied_after(text, end):
+    return denial_after(text, end)[0] in ("copular", "coordinated")
