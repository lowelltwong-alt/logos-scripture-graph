+
+def _cut10():
+    for key, verse in OSHB.items():
+        for w in verse.split(" "):
+            if w and _mark10(w[-1]):
+                k = len(w)
+                while k and _mark10(w[k - 1]):
+                    k -= 1
+                cut = w[:k]
+                if len([ch for ch in cut if "\u05d0" <= ch <= "\u05ea"]) >= 3 and not _bounded10(cut, JOINED10):
+                    return key, cut, w
+    return None, None, None
+
