+def _mark10(ch):
+    return unicodedata.category(ch) == "Mn"
+
+
+def _bounded10(needle, hay):
+    i = hay.find(needle)
+    while i != -1:
+        j = i + len(needle)
+        if j >= len(hay) or not _mark10(hay[j]):
+            return True
+        i = hay.find(needle, i + 1)
+    return False
+
+
+JOINED10 = " | ".join(OSHB.values())
