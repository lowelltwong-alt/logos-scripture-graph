+def is_mark(ch: str) -> bool:
+    """A combining mark (Unicode category Mn): points, accents, dagesh, the shin and sin dots, U+05C4. Maqaf, paseq and sof
+    pasuq are not marks."""
+    return unicodedata.category(ch) == "Mn"
+
