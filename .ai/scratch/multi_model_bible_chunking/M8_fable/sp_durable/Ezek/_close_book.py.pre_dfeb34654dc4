            "item5_final_review_status": {"candidate_review_complete": sum(1 for r in final if r["review_status"] == "candidate_review_complete"),
                                          "draft": sum(1 for r in final if r["review_status"] == "draft")},
            "item10_ow6_final_check_merged": {
                "landing_manifest": "sp_durable/Ezek/merged_close/" + LANDING.name,
