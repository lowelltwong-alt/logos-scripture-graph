                                           "corpus_reconciled": par.get("post_corpus_sha256"), "status": par.get("status"),
                                           "exact_arm_residual": par.get("exact_arm_residual"),
                                           "routed_open": par.get("routed_open")},
            "item5_hebrew_quote_bytes_and_tier_labels": {k: (suite.get("citation_sweep") or {}).get(k) for k in
                                                          ("status", "nfd_degraded_count", "rows")},
            "item5_web_quote_gloss_fidelity": {k: (suite.get("web_quotes") or {}).get(k) for k in ("status", "flag_count")},
            "item5_unicode_normalization": {k: suite["hebrew_normalize_dryrun"].get(k) for k in ("ok", "fixed", "defect_count")},
