                                                            {r["decision_id"] for r in final} for x in acf_item22))
    acf = {"lam_pattern": acf_lam, "item22": acf_item22}.get(a.acf)
    ret_bytes, ret = retention()

    fcs = {L: v for L, v in lanes.items() if v}
    conf = collections.Counter(r["confidence"] for r in final)
    ut = collections.Counter(r["unit_type"] for r in final)
    dump = lambda objs: "".join(json.dumps(o, ensure_ascii=False) + "\n" for o in objs).encode("utf-8")
    receipt = {
        "book": "Ezek", "model_id": "M8_fable",
        "mesh_revision": "m8-mesh-r3 + OW-1..OW-26 as ruled; grader fallback OW-25; merged-verdict close OW-26",
        "rows": len(final), "chunks": len(final), "parents": sorted({r["parent_collection"] for r in final}),
        "verses_covered": ezek_lib.TOTAL_VERSES, "chunk_file_sha256": shab(payload),
        "final_corpus": CORPUS, "final_corpus_sha256": CORPUS_PIN,
        "corpus_lineage_sha256": {"repair/rows_v7_cwo24.jsonl (pre-finalize)": sha(PRE_FINAL), CORPUS: sha(EZ / CORPUS)},
        "confidence_final": dict(conf.most_common()), "unit_type_distribution": dict(ut.most_common()),
