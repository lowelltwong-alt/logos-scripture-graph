GATES = []


def gate(name, ok, detail=""):
    GATES.append({"gate": name, "met": bool(ok), "detail": str(detail)[:400]})
    return bool(ok)


def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def shab(b):
    return hashlib.sha256(b).hexdigest()


def jl(p):
    return [json.loads(l) for l in Path(p).read_text(encoding="utf-8-sig").splitlines() if l.strip()]


def jload(p):
    return json.loads(Path(p).read_text(encoding="utf-8-sig"))


def hi_med(xs):
    return [r for r in (xs or []) if isinstance(r, dict) and r.get("severity") in ("high", "medium")]


def run(args):
    p = subprocess.run([sys.executable, "-B"] + args, cwd=str(EZ), capture_output=True, text=True, encoding="utf-8",
                       errors="replace", env={**__import__("os").environ, "PYTHONUTF8": "1"})
    return p.returncode, (p.stdout or "").strip().splitlines()[-1:] or [""]


def corpus_gates():
    cp = EZ / CORPUS
    gate("corpus pinned", sha(cp) == CORPUS_PIN, sha(cp)[:16])
    rows = jl(cp)
    n = len(rows)
    gate("every row candidate_review_complete", all(r["review_status"] == "candidate_review_complete" for r in rows))
    gate("chunk_index 1..N", [r["chunk_index_in_book"] for r in rows] == list(range(1, n + 1)), n)
    # tiling: contiguous over the WEB order, no gap and no overlap
    order = [(c, v) for c in sorted(ezek_lib.LAST_VERSE) for v in range(1, ezek_lib.LAST_VERSE[c] + 1)]
    lin = {cv: i for i, cv in enumerate(order)}
    prev, bad, covered = -1, [], 0
    for r in rows:
        m = re.match(r"^Ezek\.(\d+)\.(\d+)-Ezek\.(\d+)\.(\d+)$", r["span"])
        s, e = lin.get((int(m.group(1)), int(m.group(2)))), lin.get((int(m.group(3)), int(m.group(4))))
        if s is None or e is None or s != prev + 1 or e < s:
            bad.append(r["decision_id"])
        else:
            covered += e - s + 1
            prev = e
    gate("tiling contiguous over 1273 WEB verses", not bad and covered == ezek_lib.TOTAL_VERSES == len(order) == 1273
         and prev == len(order) - 1, {"covered": covered, "breaks": bad[:5]})
    runs = [k for k, _ in __import__("itertools").groupby(r["parent_collection"] for r in rows)]
    gate("each parent collection one contiguous run", len(runs) == len(set(runs)),
         [p for p, c in collections.Counter(runs).items() if c > 1][:3])
    return rows


def sidecar_gates(rows):
    low = {r["writer_decision_id"] for r in rows if r["confidence"] in ("medium_low", "low")}
    side = []
    for f in sorted(EZ.glob("sidecar_src_*.jsonl")):
        side += jl(f)
    ids = [s["writer_decision_id"] for s in side]
    gate("sidecar set == low/medium_low rows", len(ids) == len(set(ids)) and set(ids) == low,
         {"missing": sorted(low - set(ids))[:3], "extra": sorted(set(ids) - low)[:3], "rows": len(ids)})
    gate("sidecar fields present", all(s.get(k) for s in side for k in SIDE_FIELDS))
    gate("why_low_confidence not boilerplate", len({s["why_low_confidence"] for s in side}) == len(side))
    rc, tail = run([str(EZ / "deliverables" / "gen_sidecars.py"), "--check"])
    gate("gen_sidecars.py --check MATCH", rc == 0 and tail[-1] == "MATCH", tail)
    return side


def evidence_gates():
    suite = jload(EZ / (CORPUS + ".validator_report.json"))
    sm, norm = suite["summary"], suite["hebrew_normalize_dryrun"]
    gate("suite GREEN over this corpus", sm.get("hard_status") == "GREEN" and not sm.get("nfd_hard_e01")
         and Path(str(suite.get("rows_file"))).name == CORPUS, {"summary": sm, "rows_file": suite.get("rows_file")})
    gate("normalize dry-run clean", norm.get("fixed", 0) == 0 and norm.get("defect_count", 0) == 0,
         {"fixed": norm.get("fixed"), "defect_count": norm.get("defect_count")})
    pp = EZ / "cwo" / ("cwo_parity.%s.json" % CORPUS.replace(".jsonl", ""))
    par = jload(pp) if pp.is_file() else {}
    gate("CWO parity GREEN for THIS corpus", par.get("post_corpus_sha256") == CORPUS_PIN and par.get("status") == "GREEN"
         and not par.get("exact_arm_residual"), {"record": pp.name, "status": par.get("status")})
    return suite, pp, par


def carrier_gates():
    c = jload(CARRIER)
    gate("grader carrier pinned", sha(CARRIER) == CARRIER_PIN, sha(CARRIER)[:16])
    rc, tail = run([str(SP / "campaign" / "gen_grader_models.py"), "--check"])
    gate("grader carrier still transcribes the ledger (--check MATCH)", rc == 0 and tail[-1] == "MATCH", tail)
    model = c["declared_fallback_model"] if c.get("fallback_in_force") else c["ow13_grader_model"]
    shape = c.get("book_close_shapes", {}).get("Ezek") or {}
    gate("carrier grants Ezekiel the OW-26 shape", shape.get("directive") == "OW-26"
         and shape.get("transcript_audit") == "OWED, NOT MET" and shape.get("weakness_statement"))
    return c, model, shape


def lane_gates(model, fallback, landing):
    """Durable lane files resolve relative to the landing manifest's own directory, so a tampered copy of the landing
    set (--landing, dry mode only) can be pointed at the gates without touching the real one."""
    lanes = {}
    land = jload(landing) if landing.is_file() else None
    if not gate("landing manifest present", land is not None, landing.name):
        return lanes, None
    recs = jl(RECEIPTS)
    for L, att in LANES:
        ent = (land.get("lanes") or {}).get(L) or {}
        files, ok = {}, True
        for fn in LANE_FILES:
            f = (ent.get("files") or {}).get(fn) or {}
            p = landing.parent / str(f.get("durable", "")) if f.get("durable") else None
            good = p is not None and p.is_file() and sha(p) == f.get("sha256")
            ok &= good
            files[fn] = p if good else None
        gate("lane %s: six durable outputs match the landing manifest" % L, ok and ent.get("attempt_id") == att,
             [k for k, v in files.items() if v is None])
        done = [r for r in recs if r.get("attempt_id") == att and r.get("record_kind") == "completion"]
        gate("lane %s: completion receipt COMPLETED on %s" % (L, model), len(done) == 1
             and done[0].get("outcome") == "COMPLETED" and done[0].get("model_actual") == model,
             [(d.get("outcome"), d.get("model_actual")) for d in done])
        if not ok:
            lanes[L] = None
            continue
        pc, fc = jload(files["postcheck.json"]), jload(files["final_check.json"])
        it, nq, meta = jload(files["items_20_23.json"]), jload(files["named_questions.json"]), jload(files["lane_meta.json"])
        gate("lane %s: postcheck fit_to_assemble, no high/medium residual" % L,
             pc.get("verdict") == "fit_to_assemble" and not hi_med(pc.get("residual")) and not pc.get("blocking"),
             {"verdict": pc.get("verdict"), "hi_med": len(hi_med(pc.get("residual"))), "blocking": pc.get("blocking")})
        gate("lane %s: final check names the carrier's model" % L, fc.get("model") == model == meta.get("model")
             and (not fallback or "grader_fallback" in str(fc.get("grader_role", "")) + str(meta.get("grader_role", ""))),
             {"fc": fc.get("model"), "meta": meta.get("model"), "role": fc.get("grader_role") or meta.get("grader_role")})
        gate("lane %s: final check fit_to_close over THIS corpus" % L, fc.get("verdict") == "fit_to_close"
             and fc.get("corpus_sha256") == CORPUS_PIN and not hi_med(fc.get("residual")),
             {"verdict": fc.get("verdict"), "corpus": str(fc.get("corpus_sha256"))[:16], "hi_med": len(hi_med(fc.get("residual")))})
        tc = fc.get("transcript_coverage") or {}
        gate("lane %s: transcript audit recorded OWED, NOT run" % L,
             isinstance(tc.get("attempts_with_no_transcript"), int) and tc.get("bytes_audited_by_stage1") == 0
             and tc.get("reconcile_verdict") == "NOT_RUN" and "OWED" in str(tc.get("statement", "")).upper()
             and fc.get("stage1_findings_disposition") == [],
             {k: tc.get(k) for k in ("attempts_with_no_transcript", "bytes_audited_by_stage1", "reconcile_verdict")})
        cga = fc.get("close_gate_assessment")
        cga = list(cga.values()) if isinstance(cga, dict) else (cga or [])
        unmet = [g for g in cga if isinstance(g, dict) and g.get("met") is False]
        stray = [str(g.get("gate") or g.get("name") or g)[:80] for g in unmet if "transcript" not in json.dumps(g).lower()]
        gate("lane %s: the only unmet Lam gate is the owed transcript audit" % L, cga and unmet and not stray,
             {"entries": len(cga), "unmet": len(unmet), "other_unmet": stray[:4]})
        gate("lane %s: items 20-23 fit_to_accept" % L,
             all((it.get("item_%d" % i) or {}).get("fit_to_accept") is True for i in range(20, 24)),
             {i: (it.get("item_%d" % i) or {}).get("fit_to_accept") for i in range(20, 24)})
        gate("lane %s: NQ-1..NQ-10 answered" % L, all((nq.get("NQ-%d" % i) or {}).get("answer") for i in range(1, 11)))
        gate("lane %s: e19 self-report present" % L, bool(meta.get("e19_selfreport")), meta.get("e19_selfreport"))
        lanes[L] = {"attempt_id": att, "files": {k: ("sp_durable/Ezek/merged_close/" + str(v.relative_to(landing.parent)).replace("\\", "/"),
                                                     sha(v)) for k, v in files.items()},
                    "postcheck": pc, "final_check": fc, "items": it, "meta": meta}
    gate("two distinct blind lanes", all(lanes.get(L) for L, _ in LANES) and len({a for _, a in LANES}) == 2)
    return lanes, land


def target_gates():
    gate("book_chunks/Ezek/chunks.jsonl absent", not (M8 / "book_chunks" / "Ezek" / "chunks.jsonl").exists())
    gate("receipts/Ezek_completion.json absent", not (M8 / "receipts" / "Ezek_completion.json").exists())
    for n in SHARED:
        gate("%s holds no Ezek row" % n, '"book": "Ezek"' not in (M8 / n).read_text(encoding="utf-8"))
    prog = (M8 / "marathon_progress.yaml").read_text(encoding="utf-8")
    gate("marathon_progress anchors", prog.count(PROG_ANCHOR) == 1 and prog.count("books_completed: 25") == 1
         and "  Ezek:\n" not in prog)
    man = (M8 / "model_manifest.yaml").read_text(encoding="utf-8")
    gate("model_manifest anchors", man.count("books_completed: 25") == 1 and man.count("current_book: Ezek") == 1)
    gate("retention manifest absent", not RETENTION.exists())
    return prog, man


def retention():
    out = []
    for p in sorted(EZ.rglob("*")):
        if p.is_file() and "__pycache__" not in p.parts and p != RETENTION:
            b = p.read_bytes()
            out.append({"path": str(p.relative_to(EZ)).replace("\\", "/"), "bytes": len(b), "sha256": shab(b)})
    return ("".join(json.dumps(o, ensure_ascii=False) + "\n" for o in out)).encode("utf-8"), out


def zone_disclosure():
    moved = [(c, v) for c in sorted(ezek_lib.LAST_VERSE) for v in range(1, ezek_lib.LAST_VERSE[c] + 1)
             if ezek_lib.web_to_mt(c, v) != (c, v)]
    return {"web_verses_whose_mt_reference_differs": len(moved),
            "first": "Ezek.%d.%d" % moved[0] if moved else None, "last": "Ezek.%d.%d" % moved[-1] if moved else None,
            "zone_chapters": sorted(ezek_lib.ZONE_CHAPTERS), "spans_are_in": "WEB versification",
            "computed_by": "ezek_lib.web_to_mt at close"}


