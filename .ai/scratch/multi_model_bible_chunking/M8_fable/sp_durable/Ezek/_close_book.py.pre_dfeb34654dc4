         and shab(receipt["grader_fallback"]["statement"].encode("utf-8")) == carrier["downgrade_statement_sha256"])
    gate("receipt carries the OW-26 weakness statement", receipt["ow26_merged_verdict_close"]["weakness_statement"] ==
         (carrier.get("book_close_shapes", {}).get("Ezek") or {}).get("weakness_statement"))
    rec_bytes = json.dumps(receipt, ensure_ascii=False, indent=1).encode("utf-8")
    new_prog = prog.replace(PROG_ANCHOR, "  Lam:\n    status: complete\n  Ezek:\n    status: complete\ncurrent_book: %s" % NEXT_BOOK)
    new_prog = new_prog.replace("books_completed: 25", "books_completed: 26")
    new_man = man.replace("books_completed: 25", "books_completed: 26").replace("current_book: Ezek", "current_book: %s" % NEXT_BOOK)

    writes = {"book_chunks/Ezek/chunks.jsonl": payload, "sp_durable/Ezek/" + RETENTION.name: ret_bytes,
              "receipts/Ezek_completion.json": rec_bytes,
              "APPEND low_confidence_register.jsonl": dump(lcr), "APPEND frontier_escalation_queue.jsonl": dump(feq),
              "APPEND whole_bible_chunk_map.jsonl": payload,
              "EDIT marathon_progress.yaml": new_prog.encode("utf-8"), "EDIT model_manifest.yaml": new_man.encode("utf-8")}
    if acf is not None:
        writes["APPEND atlas_candidate_feed.jsonl"] = dump(acf)
    unmet = [g for g in GATES if not g["met"]]
    report = {"mode": "CLOSE" if a.close else "DRY", "gates_total": len(GATES), "gates_unmet": len(unmet),
              "unmet": unmet, "would_write": {k: {"bytes": len(v), "sha256": shab(v)} for k, v in writes.items()},
              "acf_options": {"lam_pattern": len(acf_lam), "item22": len(acf_item22),
                              "item22_confidence": dict(collections.Counter(x.get("confidence") for x in acf_item22))},
              "grader_model_from_carrier": model}

    if a.dry_report:
        d = Path(a.dry_report).resolve()
        if d == M8 or M8 in d.parents:
            raise SystemExit("REFUSED: --dry-report is inside the M8 tree")
        d.mkdir(parents=True, exist_ok=True)
        (d / "Ezek_completion.preview.json").write_bytes(rec_bytes)
        (d / "gates.json").write_text(json.dumps(GATES, ensure_ascii=False, indent=1), encoding="utf-8")
        (d / "ezek_retention_manifest.preview.jsonl").write_bytes(ret_bytes)
        report["dry_report_dir"] = str(d)
    if not a.close:
        print(json.dumps(report, ensure_ascii=False, indent=1))
        return
    if unmet:
        print(json.dumps(report, ensure_ascii=False, indent=1))
        raise SystemExit("REFUSED: %d gate(s) unmet; nothing written" % len(unmet))

    # --- CLOSE: the owner's act (OW-11 / OW-25). Every target was proven absent or anchored above. ---
    out = M8 / "book_chunks" / "Ezek"
    out.mkdir(parents=True, exist_ok=True)
    (out / "chunks.jsonl").write_bytes(payload)
    RETENTION.write_bytes(ret_bytes)
    for name, b in (("low_confidence_register.jsonl", dump(lcr)), ("frontier_escalation_queue.jsonl", dump(feq)),
                    ("atlas_candidate_feed.jsonl", dump(acf)), ("whole_bible_chunk_map.jsonl", payload)):
        with (M8 / name).open("ab") as fh:
            fh.write(b)
    (M8 / "receipts" / "Ezek_completion.json").write_bytes(rec_bytes)
    (M8 / "marathon_progress.yaml").write_bytes(new_prog.encode("utf-8"))
    (M8 / "model_manifest.yaml").write_bytes(new_man.encode("utf-8"))
    back = (M8 / "marathon_progress.yaml").read_text(encoding="utf-8")
    assert "books_completed: 26" in back and "  Ezek:\n    status: complete\ncurrent_book: %s" % NEXT_BOOK in back
    assert sha(out / "chunks.jsonl") == shab(payload) and sha(M8 / "receipts" / "Ezek_completion.json") == shab(rec_bytes)
    print(json.dumps({"status": "CLOSED", "chunks": len(final), "receipt_sha256": shab(rec_bytes),
                      "progress": "Ezek complete -> %s (26/66)" % NEXT_BOOK, "acf": a.acf}, indent=1))


