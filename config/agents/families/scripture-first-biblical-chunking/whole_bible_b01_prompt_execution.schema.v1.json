{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/whole_bible_b01_prompt_execution.schema.v1.json",
  "title": "B01 Prompt Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book", "run_id", "stage_attempt_id", "execution_id", "assignment_id", "agent_instance_id", "prompt_template_id", "role_id", "assigned_functions", "dual_role_assignment", "input_artifact_ids", "output_artifact_ids", "prompt_pack_sha256", "workflow_sha256", "runtime_adapter_sha256", "started_at", "finished_at", "time_source", "status", "raw_result_path_or_gap", "raw_result_sha256_or_gap", "scout_artifact_blindness", "sibling_model_maps_read", "shared_model_substrate", "counts_as_cross_model_independent_vote", "contains_scripture_text", "contains_source_rows", "contains_prompts_or_hidden_reasoning", "non_authorizing"],
  "properties": {
    "schema_version": {"const": "whole_bible_b01_prompt_execution.v1"},
    "book": {"type": "string", "minLength": 1},
    "run_id": {"$ref": "#/$defs/safe_id"},
    "stage_attempt_id": {"$ref": "#/$defs/safe_id"},
    "execution_id": {"$ref": "#/$defs/safe_id"},
    "assignment_id": {"$ref": "#/$defs/safe_id"},
    "agent_instance_id": {"$ref": "#/$defs/safe_id"},
    "prompt_template_id": {"enum": ["original_language_translation_scout", "literary_form_scout", "canonical_relations_and_premortem_scout", "second_temple_rabbinic_context_scout"]},
    "role_id": {"type": "string", "minLength": 1},
    "assigned_functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dual_role_assignment": {"type": "boolean"},
    "input_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prompt_pack_sha256": {"$ref": "#/$defs/digest"},
    "workflow_sha256": {"$ref": "#/$defs/digest"},
    "runtime_adapter_sha256": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "time_source": {"enum": ["runtime_attested", "unavailable_gap_recorded"]},
    "status": {"enum": ["succeeded", "gap_returned"]},
    "raw_result_path_or_gap": {"type": "string", "minLength": 1},
    "raw_result_sha256_or_gap": {"type": "string", "minLength": 1},
    "scout_artifact_blindness": {"type": "boolean"},
    "sibling_model_maps_read": {"const": false},
    "shared_model_substrate": {"const": true},
    "counts_as_cross_model_independent_vote": {"const": false},
    "contains_scripture_text": {"const": false},
    "contains_source_rows": {"const": false},
    "contains_prompts_or_hidden_reasoning": {"const": false},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
