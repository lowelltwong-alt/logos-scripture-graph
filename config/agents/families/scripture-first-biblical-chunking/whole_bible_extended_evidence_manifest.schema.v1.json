{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/whole_bible_extended_evidence_manifest.schema.v1.json",
  "title": "Whole-Bible Candidate Precompletion Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "scope", "campaign_id",
    "campaign_revision", "book", "run_id", "workflow_sha256",
    "prompt_pack_sha256", "runtime_adapter_sha256", "artifact_sets",
    "precompletion_stage_receipts", "selected_revision", "canonicalization",
    "contains_scripture_text", "contains_source_rows",
    "contains_prompts_or_hidden_reasoning", "non_authorizing"
  ],
  "properties": {
    "schema_version": {"const": "whole_bible_extended_evidence_manifest.v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "scope": {"const": "book_precompletion_B00_B09"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_revision": {"type": "integer", "minimum": 1},
    "book": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "workflow_sha256": {"$ref": "#/$defs/digest"},
    "prompt_pack_sha256": {"$ref": "#/$defs/digest"},
    "runtime_adapter_sha256": {"$ref": "#/$defs/digest"},
    "artifact_sets": {
      "type": "object", "additionalProperties": false,
      "required": ["core", "extended"],
      "properties": {
        "core": {"$ref": "#/$defs/artifact_records"},
        "extended": {"$ref": "#/$defs/artifact_records"}
      }
    },
    "precompletion_stage_receipts": {
      "type": "object", "minProperties": 10, "maxProperties": 10,
      "required": ["B00", "B01", "B02", "B03", "B04", "B05", "B06", "B07", "B08", "B09"],
      "additionalProperties": false,
      "properties": {
        "B00": {"$ref": "#/$defs/stage_ref"}, "B01": {"$ref": "#/$defs/stage_ref"},
        "B02": {"$ref": "#/$defs/stage_ref"}, "B03": {"$ref": "#/$defs/stage_ref"},
        "B04": {"$ref": "#/$defs/stage_ref"}, "B05": {"$ref": "#/$defs/stage_ref"},
        "B06": {"$ref": "#/$defs/stage_ref"}, "B07": {"$ref": "#/$defs/stage_ref"},
        "B08": {"$ref": "#/$defs/stage_ref"}, "B09": {"$ref": "#/$defs/stage_ref"}
      }
    },
    "selected_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["chunks_sha256", "active_decision_ids_sha256", "status_hold_projection_sha256"],
      "properties": {
        "chunks_sha256": {"$ref": "#/$defs/digest"},
        "active_decision_ids_sha256": {"$ref": "#/$defs/digest"},
        "status_hold_projection_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "canonicalization": {
      "type": "object", "additionalProperties": false,
      "required": ["generated_json", "ordinary_artifacts"],
      "properties": {
        "generated_json": {"const": "utf8_sorted_keys_compact_json_sha256"},
        "ordinary_artifacts": {"const": "sha256_exact_bytes"}
      }
    },
    "contains_scripture_text": {"const": false},
    "contains_source_rows": {"const": false},
    "contains_prompts_or_hidden_reasoning": {"const": false},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact_record": {
      "type": "object", "additionalProperties": false,
      "required": ["group", "artifact_id", "path", "sha256", "media_type", "scope"],
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repo_path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1},
        "scope": {"enum": ["book_candidate", "governance_input", "validator_evidence", "historical_nonqualifying"]}
      }
    },
    "artifact_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_record"}},
    "stage_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "path", "sha256"],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repo_path"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
