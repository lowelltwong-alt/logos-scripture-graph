{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "whole_bible_b01_input_manifest.v1",
  "title": "B01 exact governed input manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "book", "run_id", "stage_attempt_id", "candidate_only", "non_authorizing", "identity", "controller_event_ids", "input_manifest_sha256", "source_ids"],
  "properties": {
    "schema_version": {"const": "whole_bible_b01_input_manifest.v1"}, "kind": {"const": "input_manifest"}, "book": {"type": "string", "minLength": 2}, "run_id": {"type": "string", "minLength": 3}, "stage_attempt_id": {"type": "string", "minLength": 3}, "candidate_only": {"const": true}, "non_authorizing": {"const": true},
    "identity": {"$ref": "whole_bible_b01_typed_contract.schema.v2.json#/$defs/identity"}, "controller_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}}, "input_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z0-9._:-]+$"}},
    "source_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
  }
}
