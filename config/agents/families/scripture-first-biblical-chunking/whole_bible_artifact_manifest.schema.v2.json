{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/whole_bible_artifact_manifest.schema.v2.json",
  "title": "Whole-Bible Attempt-Scoped Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "book", "run_id", "stage_id", "attempt_id", "direction", "artifacts", "contains_scripture_text", "contains_source_rows", "contains_prompts_or_hidden_reasoning", "non_authorizing"],
  "properties": {
    "schema_version": {"const": "whole_bible_artifact_manifest.v2"},
    "manifest_id": {"type": "string", "minLength": 1},
    "book": {"type": "string", "pattern": "^[1-3]?[A-Za-z][A-Za-z0-9]*$"},
    "run_id": {"$ref": "#/$defs/safe_id"},
    "stage_id": {"enum": ["B00", "B01"]},
    "attempt_id": {"$ref": "#/$defs/safe_id"},
    "direction": {"enum": ["input", "output"]},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "contains_scripture_text": {"type": "boolean"},
    "contains_source_rows": {"type": "boolean"},
    "contains_prompts_or_hidden_reasoning": {"const": false},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "media_type", "scope"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/repo_path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
