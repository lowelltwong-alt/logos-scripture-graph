{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "whole_bible_b01_challenge_appeal.v1",
  "title": "B01 challenge or appeal ledger entry", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "entry_id", "book", "run_id", "stage_attempt_id", "candidate_only", "non_authorizing", "identity", "controller_event_ids", "target_artifact_id", "reason_code", "argument", "status", "resolution_route"],
  "properties": {
    "schema_version": {"const": "whole_bible_b01_challenge_appeal.v1"}, "kind": {"enum": ["challenge", "appeal"]}, "entry_id": {"type": "string", "minLength": 8},
    "book": {"type": "string", "minLength": 2}, "run_id": {"type": "string", "minLength": 3}, "stage_attempt_id": {"type": "string", "minLength": 3}, "candidate_only": {"const": true}, "non_authorizing": {"const": true},
    "identity": {"$ref": "whole_bible_b01_typed_contract.schema.v2.json#/$defs/identity"}, "controller_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "target_artifact_id": {"type": "string", "minLength": 3}, "reason_code": {"type": "string", "pattern": "^QF-[A-Z0-9-]+$"}, "argument": {"type": "string", "minLength": 24},
    "status": {"enum": ["open", "resolved", "deferred_to_human", "superseded"]}, "resolution_route": {"type": "string", "minLength": 12}, "resolution": {"type": "string"}
  }
}
