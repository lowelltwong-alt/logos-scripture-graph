{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/whole_bible_stage_receipt.schema.v1.json",
  "title": "Whole-Bible Candidate Stage Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "campaign_id", "campaign_revision",
    "book", "run_id", "stage_id", "attempt_id", "attempt_kind",
    "role_or_deterministic_gate", "executor_kind",
    "prompt_template_id_or_deterministic", "prompt_pack_sha256",
    "workflow_sha256", "runtime_adapter_sha256", "input_manifest_path",
    "input_manifest_sha256", "output_manifest_path", "output_manifest_sha256",
    "input_artifact_sha256", "output_artifact_sha256",
    "prior_stage_receipt_sha256", "prior_stage_receipt_path", "started_at", "finished_at", "outcome",
    "unresolved_holds", "stage_evidence", "independence_scope",
    "shared_model_substrate", "counts_as_cross_model_independent_vote",
    "state_fingerprint", "non_authorizing"
  ],
  "properties": {
    "schema_version": {"const": "whole_bible_stage_receipt.v1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_revision": {"type": "integer", "minimum": 1},
    "book": {"type": "string", "pattern": "^[1-3]?[A-Za-z][A-Za-z0-9]*$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "stage_id": {"enum": ["B00", "B01", "B02", "B03", "B04", "B05", "B06", "B07", "B08", "B09", "B10"]},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "attempt_kind": {"enum": ["original", "bounded_repair", "resume"]},
    "role_or_deterministic_gate": {"type": "string", "minLength": 1},
    "executor_kind": {"enum": ["agent", "deterministic"]},
    "prompt_template_id_or_deterministic": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prompt_pack_sha256": {"$ref": "#/$defs/digest"},
    "workflow_sha256": {"$ref": "#/$defs/digest"},
    "runtime_adapter_sha256": {"$ref": "#/$defs/digest"},
    "input_manifest_path": {"$ref": "#/$defs/repo_path"},
    "input_manifest_sha256": {"$ref": "#/$defs/digest"},
    "output_manifest_path": {"$ref": "#/$defs/repo_path"},
    "output_manifest_sha256": {"$ref": "#/$defs/digest"},
    "input_artifact_sha256": {"$ref": "#/$defs/digest_map"},
    "output_artifact_sha256": {"$ref": "#/$defs/digest_map"},
    "prior_stage_receipt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "prior_stage_receipt_path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/repo_path"}]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["succeeded", "pass_with_holds", "failed", "blocked_human"]},
    "unresolved_holds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stage_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_refs", "artifact_sha256", "values"],
      "properties": {
        "artifact_refs": {
          "type": "object", "additionalProperties": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            ]
          }
        },
        "artifact_sha256": {
          "type": "object", "additionalProperties": {
            "oneOf": [
              {"$ref": "#/$defs/digest"},
              {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}
            ]
          }
        },
        "values": {"type": "object"}
      }
    },
    "independence_scope": {
      "type": "object", "additionalProperties": false,
      "required": [
        "authoring_independent_from_sibling_maps", "artifact_blindness",
        "role_separation", "shared_model_substrate",
        "runtime_model_identity_attested", "independent_model_or_provider_evidence",
        "counts_as_cross_model_independent_vote", "convergence_weight"
      ],
      "properties": {
        "authoring_independent_from_sibling_maps": {"type": "boolean"},
        "artifact_blindness": {"type": "boolean"},
        "role_separation": {"type": "boolean"},
        "shared_model_substrate": {"const": true},
        "runtime_model_identity_attested": {"const": false},
        "independent_model_or_provider_evidence": {"const": false},
        "counts_as_cross_model_independent_vote": {"const": false},
        "convergence_weight": {"const": "one_model_voice"},
        "independence_evidence_ref": {"$ref": "#/$defs/repo_path"}
      }
    },
    "shared_model_substrate": {"const": true},
    "counts_as_cross_model_independent_vote": {"const": false},
    "state_fingerprint": {"$ref": "#/$defs/digest"},
    "failure_fingerprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "non_authorizing": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repo_path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "digest_map": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}}
  }
}
