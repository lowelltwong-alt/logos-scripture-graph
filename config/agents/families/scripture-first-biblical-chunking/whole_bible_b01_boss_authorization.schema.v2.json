{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "whole_bible_b01_boss_authorization.v2",
  "title": "B01 independent boss review (non-authorizing)", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "book", "run_id", "stage_attempt_id", "candidate_only", "non_authorizing", "identity", "controller_event_ids", "input_manifest_sha256", "packet_sha256", "redteam_digest", "verdict", "rationale", "rejected_alternatives", "dissent", "appeal_route"],
  "properties": {
    "schema_version": {"const": "whole_bible_b01_boss_authorization.v2"}, "kind": {"const": "boss_authorization"},
    "book": {"type": "string", "minLength": 2}, "run_id": {"type": "string", "minLength": 3}, "stage_attempt_id": {"type": "string", "minLength": 3},
    "candidate_only": {"const": true}, "non_authorizing": {"const": true}, "identity": {"$ref": "whole_bible_b01_typed_contract.schema.v2.json#/$defs/identity"},
    "controller_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "input_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "packet_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "redteam_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verdict": {"enum": ["GO_B01_RECEIPT_ONLY", "NO_GO", "HOLD"]}, "rationale": {"type": "string", "minLength": 24},
    "rejected_alternatives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "dissent": {"type": "array", "items": {"type": "string", "minLength": 1}}, "appeal_route": {"type": "string", "minLength": 12}
  }
}
