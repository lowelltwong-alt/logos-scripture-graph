__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.env
.venv/
.digital-asset/

# Raw sources ARE committed (small, public-domain WEB zip = reproducibility anchor).
# Larger future raw archives belong in Git LFS or external storage.
# data/raw/**/*.zip

# Generated data is regenerable from raw + importer (see DATA_MAP.md commit policy
# and ADR-0007). Not committed: avoids 500MB+ in git on OneDrive. CI regenerates it.
data/canonical/scripture/
data/canonical/translations/
data/processed/bible/
# Chunking run outputs (big, regenerable per agent/run); only scorecards in eval/ are committed.
data/derived/chunks/
# T310 candidate form classifications (sidecar; never canonical).
data/candidate/chunking/

build/*
!build/.gitkeep
!build/discovery/
!build/discovery/**

# Python build artifacts (from pip install -e .)
*.egg-info/

# Rust build artifacts for the isolated T412 scanner crate.
tools/usfm_observation_scanner/target/

# Rust build artifacts for the isolated T424 fast-validator crate.
tools/logos_fast_validators/target/
