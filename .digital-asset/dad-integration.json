  "journal": {
    "surface_version": "1.0.0",
    "mode": "plan_only_until_human_gate",
    "checkpoint_scope": "DAD_DATA_ROOT data plane only",
    "checkpoint_threshold": ">=200 new records or >=24h",
    "source_repo_writes": false,
