{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WordToken",
  "type": "object",
  "required": [
    "id",
    "type",
    "passage_id",
    "osis_ref",
    "translation_id",
    "word_index",
    "surface_text",
    "strong",
    "source_marker",
    "source_sha256",
    "license",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "WordToken" },
    "passage_id": { "type": "string" },
    "osis_ref": { "type": "string" },
    "translation_id": { "const": "eng-web" },
    "word_index": { "type": "integer" },
    "surface_text": { "type": "string" },
    "strong": { "type": ["string", "null"] },
    "attributes": { "type": "object" },
    "is_nested": { "type": "boolean" },
    "nesting_context": { "type": "array", "items": { "type": "string" } },
    "source_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
