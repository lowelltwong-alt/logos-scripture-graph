{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos-scripture-graph/schemas/embedding_model.schema.json",
  "title": "EmbeddingModelRegistryEntry",
  "description": "Durable registry record for an embedding model. Vectors are derived artifacts; this record is what survives model retirement. One registered model per vector space; never mix spaces in one index.",
  "type": "object",
  "required": [
    "embedding_model_id",
    "provider",
    "model_name",
    "model_version",
    "dimension",
    "normalization",
    "distance_metric",
    "status",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "embedding_model_id": {
      "type": "string",
      "pattern": "^emb:[a-z0-9][a-z0-9._-]*$",
      "description": "Stable internal id, e.g. emb:voyage-3-large-2026"
    },
    "provider": { "type": "string", "minLength": 1 },
    "model_name": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "dimension": { "type": "integer", "minimum": 1 },
    "normalization": { "type": "string", "enum": ["l2", "none", "provider_default"] },
    "distance_metric": { "type": "string", "enum": ["cosine", "dot", "euclidean"] },
    "max_input_tokens": { "type": "integer", "minimum": 1 },
    "deployment": { "type": "string", "enum": ["cloud", "local", "hybrid"] },
    "data_residency": { "type": "string" },
    "approved_use_cases": { "type": "array", "items": { "type": "string" } },
    "not_approved_use_cases": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["registered", "candidate", "approved", "deprecated", "retired", "rejected"],
      "description": "approved requires an owner decision; retired models keep their record forever so old manifests stay interpretable"
    },
    "owner_decision_ref": { "type": "string" },
    "created_at": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
