{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RelationshipObject",
  "type": "object",
  "required": [
    "id",
    "type",
    "subject_id",
    "predicate",
    "object_id",
    "assertion_mode",
    "evidence_refs",
    "confidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "RelationshipObject"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "assertion_mode": {
      "type": "string",
      "enum": [
        "asserted",
        "inferred",
        "candidate"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trust_zone": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
