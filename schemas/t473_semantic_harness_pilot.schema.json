{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logos.local/schemas/t473_semantic_harness_pilot.schema.json",
  "title": "T473 semantic harness pilot artifact",
  "description": "Typed, non-authorizing artifacts for a sealed proposer/critic Bible chunking calibration pilot.",
  "oneOf": [
    {
      "$ref": "#/$defs/pilot_scope"
    },
    {
      "$ref": "#/$defs/run_lock"
    },
    {
      "$ref": "#/$defs/model_decision"
    },
    {
      "$ref": "#/$defs/disagreement_region"
    },
    {
      "$ref": "#/$defs/candidate_span"
    },
    {
      "$ref": "#/$defs/overlap_admission"
    },
    {
      "$ref": "#/$defs/reconciliation"
    },
    {
      "$ref": "#/$defs/completion_receipt"
    }
  ],
  "$defs": {
    "osis_span": {
      "type": "string",
      "pattern": "^[1-3]?[A-Za-z]+\\.[0-9]+\\.[0-9]+-[1-3]?[A-Za-z]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "pilot_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "scope_id",
        "calibration_span",
        "literature_family",
        "literary_parent_question",
        "required_internal_structure",
        "guardrail_ids"
      ],
      "properties": {
        "artifact_type": {
          "const": "pilot_scope"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "scope_id": {
          "enum": [
            "T473-SCOPE-2KGS",
            "T473-SCOPE-1CHR",
            "T473-SCOPE-2JOHN",
            "T473-SCOPE-PS119"
          ]
        },
        "calibration_span": {
          "$ref": "#/$defs/osis_span"
        },
        "literature_family": {
          "type": "string",
          "minLength": 3
        },
        "literary_parent_question": {
          "type": "string",
          "minLength": 10
        },
        "required_internal_structure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "guardrail_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "run_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "run_id",
        "scope_inventory_hash",
        "substrate_hashes",
        "prompt_hashes",
        "strategy_hashes",
        "allowed_input_hashes",
        "participant_roles",
        "t472_source_hashes",
        "committed_before_execution"
      ],
      "properties": {
        "artifact_type": {
          "const": "run_lock"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "run_id": {
          "type": "string",
          "minLength": 6
        },
        "scope_inventory_hash": {
          "$ref": "#/$defs/sha256"
        },
        "substrate_hashes": {
          "$ref": "#/$defs/hash_map"
        },
        "prompt_hashes": {
          "$ref": "#/$defs/hash_map"
        },
        "strategy_hashes": {
          "$ref": "#/$defs/hash_map"
        },
        "allowed_input_hashes": {
          "$ref": "#/$defs/hash_map"
        },
        "t472_source_hashes": {
          "$ref": "#/$defs/hash_map"
        },
        "participant_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proposer",
            "critic"
          ],
          "properties": {
            "proposer": {
              "type": "string",
              "minLength": 2
            },
            "critic": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "committed_before_execution": {
          "const": true
        }
      }
    },
    "model_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "run_id",
        "scope_id",
        "role",
        "model_id",
        "decision_id",
        "strategy_section_id",
        "evidence_ids",
        "exact_spans",
        "confidence",
        "limitations",
        "sealed_at",
        "output_sha256"
      ],
      "properties": {
        "artifact_type": {
          "const": "model_decision"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "run_id": {
          "type": "string",
          "minLength": 6
        },
        "scope_id": {
          "type": "string",
          "pattern": "^T473-SCOPE-"
        },
        "role": {
          "enum": [
            "strong_proposer",
            "independent_strong_critic"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 2
        },
        "decision_id": {
          "type": "string",
          "minLength": 4
        },
        "strategy_section_id": {
          "type": "string",
          "minLength": 3
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "exact_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/osis_span"
          }
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "disagreement_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "region_id",
        "scope_id",
        "region_span",
        "model_decision_ids",
        "diagnostic_only",
        "candidate_span_eligible"
      ],
      "properties": {
        "artifact_type": {
          "const": "disagreement_region"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "region_id": {
          "type": "string",
          "minLength": 4
        },
        "scope_id": {
          "type": "string",
          "pattern": "^T473-SCOPE-"
        },
        "region_span": {
          "$ref": "#/$defs/osis_span"
        },
        "model_decision_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "diagnostic_only": {
          "const": true
        },
        "candidate_span_eligible": {
          "const": false
        }
      }
    },
    "overlap_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "admission_id",
        "candidate_span",
        "relation",
        "evidence_surfaces",
        "blocking",
        "admission_decision"
      ],
      "properties": {
        "artifact_type": {
          "const": "overlap_admission"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "admission_id": {
          "type": "string",
          "minLength": 4
        },
        "candidate_span": {
          "$ref": "#/$defs/osis_span"
        },
        "relation": {
          "enum": [
            "disjoint",
            "equal",
            "strictly_contains",
            "strictly_within",
            "overlap"
          ]
        },
        "evidence_surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "blocking": {
          "type": "boolean"
        },
        "admission_decision": {
          "enum": [
            "none",
            "blocked_pending_owner_compatibility_review"
          ]
        }
      }
    },
    "candidate_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "candidate_id",
        "scope_id",
        "span",
        "origin_kind",
        "source_decision_id",
        "observed_source_span",
        "literary_evidence_ids",
        "overlap_admission_id",
        "derived_from_region_or_vote"
      ],
      "properties": {
        "artifact_type": {
          "const": "candidate_span"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 4
        },
        "scope_id": {
          "type": "string",
          "pattern": "^T473-SCOPE-"
        },
        "span": {
          "$ref": "#/$defs/osis_span"
        },
        "origin_kind": {
          "enum": [
            "exact_observed_model_span",
            "exact_owner_supplied_span"
          ]
        },
        "source_model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_owner_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_decision_id": {
          "type": "string",
          "minLength": 4
        },
        "observed_source_span": {
          "$ref": "#/$defs/osis_span"
        },
        "literary_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "overlap_admission_id": {
          "type": "string",
          "minLength": 4
        },
        "derived_from_region_or_vote": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "exact_observed_model_span"
              }
            }
          },
          "then": {
            "required": [
              "source_model_id"
            ],
            "properties": {
              "source_model_id": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin_kind": {
                "const": "exact_owner_supplied_span"
              }
            }
          },
          "then": {
            "required": [
              "source_owner_id"
            ],
            "properties": {
              "source_owner_id": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        }
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "run_id",
        "scope_id",
        "proposer_receipt_sha256",
        "critic_receipt_sha256",
        "both_sealed_before_read",
        "disposition",
        "reasons"
      ],
      "properties": {
        "artifact_type": {
          "const": "reconciliation"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "run_id": {
          "type": "string",
          "minLength": 6
        },
        "scope_id": {
          "type": "string",
          "pattern": "^T473-SCOPE-"
        },
        "proposer_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "critic_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "both_sealed_before_read": {
          "const": true
        },
        "disposition": {
          "enum": [
            "reconcile_by_codex",
            "frontier_review_required",
            "owner_decision_required",
            "harness_fix_required",
            "deferred"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "completion_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "non_authorizing",
        "candidate_eligible",
        "promotion_authority",
        "run_id",
        "scope_ids",
        "role",
        "model_id",
        "run_lock_sha256",
        "output_sha256",
        "completion_state",
        "sealed_at"
      ],
      "properties": {
        "artifact_type": {
          "const": "completion_receipt"
        },
        "schema_version": {
          "const": "t473_semantic_harness_pilot.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "candidate_eligible": {
          "const": false
        },
        "promotion_authority": {
          "const": "none"
        },
        "run_id": {
          "type": "string",
          "minLength": 6
        },
        "scope_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "T473-SCOPE-2KGS",
              "T473-SCOPE-1CHR",
              "T473-SCOPE-2JOHN",
              "T473-SCOPE-PS119"
            ]
          }
        },
        "role": {
          "enum": [
            "strong_proposer",
            "independent_strong_critic"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 2
        },
        "run_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "completion_state": {
          "const": "sealed_complete"
        },
        "sealed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
