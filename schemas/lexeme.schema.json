{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lexeme",
  "description": "Candidate dictionary/lemma-level source-language unit. Strong's is a lookup bridge and never source text, lexical truth, isolated-word theology, or translation judgment authority.",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "language",
    "lexical_source",
    "trust_zone",
    "confidence",
    "provenance",
    "authority",
    "non_authorizations",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "Lexeme" },
    "schema_version": { "const": "lexeme.v2" },
    "language": { "type": "string", "enum": ["hebrew", "aramaic", "greek"] },
    "strong": { "type": ["string", "null"], "description": "Strong's number as lookup/alignment hint only." },
    "lemma": { "type": ["string", "null"], "description": "Dictionary form when licensed lexical evidence is available." },
    "transliteration": { "type": "string" },
    "glosses": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Short English glosses, not a full definition or theology claim."
    },
    "semantic_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lexical_source": { "type": "string", "minLength": 1 },
    "phrase_clause_context_required": { "const": true },
    "trust_zone": { "type": "string", "enum": ["candidate", "context"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "disputed", "unknown"] },
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at", "basis", "license"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "source_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": [
        "authorizes_lexical_truth",
        "authorizes_isolated_word_theology",
        "authorizes_translation_judgment",
        "authorizes_theology_authority"
      ],
      "properties": {
        "authorizes_lexical_truth": { "const": false },
        "authorizes_isolated_word_theology": { "const": false },
        "authorizes_translation_judgment": { "const": false },
        "authorizes_theology_authority": { "const": false }
      },
      "additionalProperties": true
    },
    "non_authorizations": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "type": "string", "enum": ["candidate", "review_packet", "blocked", "deprecated"] }
  },
  "additionalProperties": true
}
