{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlossaryEntry",
  "type": "object",
  "required": ["id", "type", "term", "definition", "raw_marker", "source_sha256", "license", "status"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "GlossaryEntry" },
    "term": { "type": "string" },
    "definition": { "type": "string" },
    "translation_id": { "const": "eng-web" },
    "raw_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
