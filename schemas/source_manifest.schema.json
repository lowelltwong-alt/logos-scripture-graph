{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceManifest",
  "type": "object",
  "required": [
    "id",
    "source_family",
    "title",
    "language",
    "format",
    "license",
    "archive_path",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source_family": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "dialect": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "archive_path": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "trademark_notice": {
      "type": "string"
    },
    "downloaded_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
