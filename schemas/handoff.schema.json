{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffMetadata",
  "type": "object",
  "required": [
    "task_id",
    "agent_name",
    "mode",
    "stage",
    "handoff_path",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{3,}$"
    },
    "agent_name": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "handoff_path": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_command": {
      "type": "string"
    },
    "validation_result": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
