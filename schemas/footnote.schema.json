{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Footnote",
  "type": "object",
  "required": [
    "id",
    "type",
    "passage_id",
    "osis_ref",
    "translation_id",
    "raw_marker",
    "source_sha256",
    "license",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "Footnote" },
    "passage_id": { "type": ["string", "null"] },
    "osis_ref": { "type": ["string", "null"] },
    "translation_id": { "const": "eng-web" },
    "reference": { "type": ["string", "null"] },
    "text": { "type": ["string", "null"] },
    "alternate_readings": { "type": "array" },
    "labels": { "type": "array" },
    "hebrew_word_spans": { "type": "array" },
    "book_title_spans": { "type": "array" },
    "submarkers": { "type": "object" },
    "raw_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
