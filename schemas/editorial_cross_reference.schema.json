{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EditorialCrossReference",
  "type": "object",
  "required": [
    "id",
    "type",
    "passage_id",
    "osis_ref",
    "translation_id",
    "relation_type",
    "target_text",
    "raw_marker",
    "source_sha256",
    "license",
    "status"
  ],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "EditorialCrossReference" },
    "passage_id": { "type": "string" },
    "osis_ref": { "type": "string" },
    "translation_id": { "const": "eng-web" },
    "relation_type": { "const": "editorial_cross_reference" },
    "origin": { "type": ["string", "null"] },
    "target_text": { "type": "string" },
    "candidate_osis_refs": { "type": "array", "items": { "type": "string" } },
    "raw_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
