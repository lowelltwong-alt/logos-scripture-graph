{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryClaim",
  "type": "object",
  "required": ["id", "type", "boundary_kind", "marker", "raw_marker", "source_sha256", "license", "status"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "BoundaryClaim" },
    "passage_id": { "type": ["string", "null"] },
    "osis_ref": { "type": ["string", "null"] },
    "translation_id": { "const": "eng-web" },
    "boundary_kind": { "type": "string" },
    "marker": { "type": "string" },
    "claim_scope": { "type": "string" },
    "is_canonical_ancient_boundary": { "type": "boolean" },
    "raw_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
