{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SectionHeading",
  "type": "object",
  "required": ["id", "type", "marker", "text", "raw_marker", "source_sha256", "license", "status"],
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "SectionHeading" },
    "passage_id": { "type": ["string", "null"] },
    "osis_ref": { "type": ["string", "null"] },
    "anchor_kind": {
      "type": "string",
      "enum": ["current_content", "next_content_start", "between_units", "chapter_context", "book_context", "unresolved"]
    },
    "anchor_osis_ref": { "type": ["string", "null"] },
    "prior_osis_ref": { "type": ["string", "null"] },
    "next_osis_ref": { "type": ["string", "null"] },
    "body_disposition": {
      "type": "string",
      "enum": ["append_current", "editorial_only", "none", "unresolved"]
    },
    "anchor_resolved": { "type": "boolean" },
    "translation_id": { "const": "eng-web" },
    "marker": { "type": "string" },
    "text": { "type": "string" },
    "source_event_id": { "type": "string" },
    "raw_marker": { "type": "string" },
    "source_sha256": { "type": "string" },
    "license": { "type": "string" },
    "status": { "type": "string" }
  },
  "additionalProperties": true
}
